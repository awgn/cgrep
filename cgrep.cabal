cabal-version: 2.2
name: cgrep
description: Cgrep: a context-aware grep for source codes
version: 10.0.0
synopsis: Command line tool
homepage: http://awgn.github.io/cgrep/
license: GPL-2.0-or-later
license-file: LICENSE
author: Nicola Bonelli
maintainer: Nicola Bonelli <nicola@larthia.com>
category: Utils
build-type: Simple
stability: Experimental
extra-source-files: README.md, cbits/cgrep_io.c

flag enable_pcre {
    Description: "Use PCRE regex engine (default: disabled)"
    Default: False
}

flag enable_cbits {
    Description: "Use C SIMD/POSIX fast paths for I/O, scandir, and prefiltering (default: enabled)"
    Default: True
}

common common-options
  build-depends: base >=4.15.0.0 && <5.0
  default-extensions:
    CPP
    BangPatterns
    DerivingStrategies
    DeriveGeneric
    ExistentialQuantification
    FlexibleContexts
    FlexibleInstances
    GeneralisedNewtypeDeriving
    LambdaCase
    MagicHash
    MultiWayIf
    OverloadedLists
    OverloadedRecordDot
    OverloadedStrings
    PatternSynonyms
    RecordWildCards
    ScopedTypeVariables
    TupleSections
    TypeApplications
    UnboxedSums
    UnboxedTuples
    ViewPatterns
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-uni-patterns
    -Wincomplete-record-updates
    -Wunused-binds
    -Wunused-do-bind
    -Wunused-foralls
    -Wunused-imports
    -Wunused-local-binds
    -Wunused-matches
    -Wunused-pattern-binds
    -Wunused-top-binds
    -Wunused-type-patterns

  if impl(ghc >=8.0)
    ghc-options: -Wredundant-constraints

  if impl(ghc >=8.2)
    ghc-options: -fhide-source-paths

  if impl(ghc >=8.4)
    ghc-options:
      -Wmissing-export-lists
      -Wpartial-fields

  if impl(ghc >=8.8)
    ghc-options: -Wmissing-deriving-strategies

  if flag (enable_pcre)
    cpp-options: -DENABLE_PCRE

  if flag (enable_cbits)
    cpp-options: -DENABLE_CBITS

  default-language: Haskell2010

library
  import: common-options
  hs-source-dirs: src
  exposed-modules:
    CGrep.Boundary
    CGrep.Common
    CGrep.Text
    CGrep.Line
    CGrep.Distance
    CGrep.FileKind
    CGrep.FileType
    CGrep.FileTypeMap
    CGrep.FileTypeMapTH
    CGrep.Match
    CGrep.Search
    CGrep.Semantic.ContextFilter
    CGrep.Semantic.Tests
    CGrep.Semantic.Tests.Common
    CGrep.Semantic.Tests.Bash
    CGrep.Semantic.Tests.C
    CGrep.Semantic.Tests.Clojure
    CGrep.Semantic.Tests.Csharp
    CGrep.Semantic.Tests.D
    CGrep.Semantic.Tests.Dart
    CGrep.Semantic.Tests.Elixir
    CGrep.Semantic.Tests.Elm
    CGrep.Semantic.Tests.Erlang
    CGrep.Semantic.Tests.Fsharp
    CGrep.Semantic.Tests.Go
    CGrep.Semantic.Tests.Haskell
    CGrep.Semantic.Tests.Java
    CGrep.Semantic.Tests.Javascript
    CGrep.Semantic.Tests.Julia
    CGrep.Semantic.Tests.Kotlin
    CGrep.Semantic.Tests.Lua
    CGrep.Semantic.Tests.Nim
    CGrep.Semantic.Tests.OCaml
    CGrep.Semantic.Tests.PHP
    CGrep.Semantic.Tests.Perl
    CGrep.Semantic.Tests.Python
    CGrep.Semantic.Tests.R
    CGrep.Semantic.Tests.Ruby
    CGrep.Semantic.Tests.Rust
    CGrep.Semantic.Tests.Scala
    CGrep.Semantic.Tests.Swift
    CGrep.Semantic.Tests.Zig
    CGrep.Parser.Atom
    CGrep.Parser.Char
    CGrep.Parser.Chunk
    CGrep.Parser.Token
    CGrep.Strategy.BoyerMoore
    CGrep.Strategy.Levenshtein
    CGrep.Strategy.Regex
    CGrep.Strategy.Semantic
    CGrep.Strategy.Tokenizer
    CmdOptions
    Config
    Options
    OsPath
    PutMessage
    Reader
    Util

  other-modules:
    Paths_cgrep
  autogen-modules:
    Paths_cgrep
  build-depends:
    aeson,
    ansi-terminal,
    atomic-primops,
    array,
    async,
    concurrency,
    clock,
    bitarray,
    bitwise,
    bytestring,
    bytestring-strict-builder,
    containers,
    deepseq,
    directory,
    dlist,
    either,
    exceptions,
    extra,
    filepath,
    ghc-prim,
    template-haskell,
    mmap,
    monad-loops,
    mtl,
    optparse-applicative >= 0.19,
    os-string,
    process,
    regex-base,
    regex-tdfa,
    safe,
    split,
    stm,
    stringsearch,
    text,
    transformers,
    unicode-show,
    unix-compat,
    unordered-containers,
    utf8-string,
    vector,
    yaml,

  if flag (enable_pcre) {
     build-depends: regex-pcre-text
  }

  if flag (enable_cbits) {
    c-sources:
      cbits/cgrep_io.c

    cc-options:
      -O3
  }

  ghc-options:
    -O2
    -optc-O3
    -funbox-strict-fields
    -fwrite-ide-info
    -hiedir=.hie

executable cgrep
  import: common-options
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    cgrep,
    filepath,
    optparse-applicative >= 0.19,
    os-string,
    text,
    transformers,

  ghc-options:
    -O2
    -optc-O3
    -funbox-strict-fields
    -fwrite-ide-info
    -hiedir=.hie
    -threaded
    -rtsopts
    "-with-rtsopts=-N -A8m -n2m -qg"

test-suite cgrep-test
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: specs
  main-is: Spec.hs
  other-modules:
    ContextFilterSpec
    LanguageTestParsersSpec
    ParserTokenAtomSpec
    PropertySpec
    SemanticTestFilterSpec
    TestHelpers
  build-depends:
    QuickCheck,
    bytestring,
    cgrep,
    containers,
    directory,
    extra,
    filepath,
    optparse-applicative >= 0.19,
    os-string,
    tasty,
    tasty-hunit,
    tasty-quickcheck,
    text,
    transformers,
    vector,
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
    -fwrite-ide-info
    -hiedir=.hie

benchmark cgrep-bench
  import: common-options
  type: exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is: Main.hs
  other-modules:
    BenchCorpus
  build-depends:
    cgrep,
    containers,
    criterion,
    deepseq,
    directory,
    filepath,
    os-string,
    text,
    transformers,
    vector,
  ghc-options:
    -O2
    -optc-O3
    -funbox-strict-fields
    -rtsopts
    "-with-rtsopts=-T -A64m"
    -fwrite-ide-info
    -hiedir=.hie
